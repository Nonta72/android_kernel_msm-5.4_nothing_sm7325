# ABI hacks
CONFIG_LOCALVERSION="-qgki-g4ddb22d91965"
CONFIG_LOCALVERSION_AUTO=n
# General Halium enablement
CONFIG_CMDLINE="binder.global_pid_lookups=1 systemd.unified_cgroup_hierarchy=1 selinux=0"
CONFIG_SYSVIPC=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_VT=y
CONFIG_NULL_TTY=y
CONFIG_DEVTMPFS=y
# CONFIG_LTO_CLANG_FULL=y will fail without a LOT of RAM
CONFIG_LTO_CLANG_THIN=y

# Trying to get telnet at all cost. Configs to override any other occurence in the other configs
# Core USB gadget framework
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_EEM=y

# Legacy Android gadget (for fallback if supported)
CONFIG_USB_ANDROID=y
CONFIG_USB_ANDROID_RNDIS=y
CONFIG_USB_ANDROID_RNDIS_DWORD_ALIGNED=y

# USB networking
CONFIG_USB_ETH=y
CONFIG_USB_ETH_RNDIS=y
CONFIG_USB_ETH_EEM=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_USBNET=y

# Networking stack essentials
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_IP_PNP_BOOTP=y
CONFIG_IP_PNP_RARP=y

# Extra debugging support
CONFIG_TUN=y

# Avoid common conflicts
CONFIG_USB_CONFIGFS_MASS_STORAGE=n
CONFIG_USB_CONFIGFS_MTP=n
CONFIG_USB_CONFIGFS_PTP=n
CONFIG_USB_CONFIGFS_F_FS=n

# Keep OTG but beware autosuspend
CONFIG_USB_OTG_FSM=y
CONFIG_USB_SUSPEND=n
